# Optional. Overrides the API base URL the app talks to (see src/lib/apiClient.ts).
# Leave unset for normal dev — it's auto-detected: your machine's LAN IP when
# running via `expo start` (Expo Go or a dev client), 10.0.2.2 on the Android
# emulator, localhost on iOS simulator/web.
EXPO_PUBLIC_API_URL=

# Required for live runner-location tracking (src/lib/realtime.ts).
# Project URL and anon (public) key from Supabase → Settings → API.
# The anon key is safe to ship in the app — it's the public client key,
# not the service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
