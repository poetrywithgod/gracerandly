# Only needed for a custom dev-client build (EAS build or `expo run:android`/
# `expo run:ios`) — Expo Go can't apply these at all, since it's a fixed
# pre-built binary that ignores config-plugin changes to native code.
# Get a key at https://console.cloud.google.com/apis/credentials with the
# "Maps SDK for Android" (and, if targeting iOS with Google's renderer,
# "Maps SDK for iOS") API enabled.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
