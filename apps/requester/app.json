{
  "expo": {
    "name": "Gracerandly",
    "slug": "gracerandly-requester",
    "version": "1.0.0",
    "scheme": "gracerandly",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Gracerandly uses your camera for video calls with your requester/runner.",
        "NSMicrophoneUsageDescription": "Gracerandly uses your microphone for voice notes and calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#502D55",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.cyberscribe.gracerandlyrequester"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Gracerandly uses your location to set pickup and drop-off points for your errands."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gracerandly uses your photos to set your profile picture.",
          "cameraPermission": "Gracerandly uses your camera to take a profile picture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Gracerandly uses your microphone for voice notes and calls."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "56d22672-996c-4a4e-bba7-b35fea39df50"
      }
    }
  }
}
