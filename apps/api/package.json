{
  "name": "@gracerandly/api",
  "version": "1.0.0",
  "private": true,
  "description": "Gracerandly API layer - the only thing the mobile and admin apps talk to",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "type-check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "fake-runner": "tsx scripts/fake-runner.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@gracerandly/shared-types": "workspace:*",
    "@gracerandly/theme": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
