PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<database>
# e.g. postgresql://postgres:postgres@localhost:5432/gracerandly
DATABASE_URL=

# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Get a test secret key from https://dashboard.paystack.com/#/settings/developer.
# Powers the wallet tab's escrow pay-in (routes/wallet.ts) — initializing a
# transaction, verifying it, and checking webhook signatures. Unlike the
# SMS/email providers below, there's no console/dev fallback here: an unset
# key makes payment calls fail loudly instead of silently pretending to
# succeed. To receive Paystack's webhook locally, tunnel this server (e.g.
# `ngrok http 4000`) and register <tunnel-url>/wallet/paystack/webhook in
# the dashboard — otherwise the app still works via the manual /wallet/verify
# call the requester app makes when it returns from checkout.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FIREBASE_SERVER_KEY=

# Only needed for scripts/fake-runner.ts (see: pnpm fake-runner) — the
# Project URL and anon (public) key from Supabase → Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SMS (phone verification codes) — with this unset, the API falls back to
# logging the code to the server console instead of sending a real text, so
# the verification flow still works end-to-end in dev. Point this at a real
# provider (Termii/Africa's Talking are common for Nigerian numbers) before
# shipping to production.
# "console" logs the code; "termii" sends real texts (needs the three below).
SMS_PROVIDER=console
TERMII_API_KEY=
# Sender ID registered/approved on your Termii account (shows as the sender).
TERMII_SENDER_ID=
# Optional. Termii "generic" route is the default; use "dnd" for numbers with
# Do-Not-Disturb on (needs it enabled on your Termii account).
TERMII_CHANNEL=generic
# Optional. Only change if Termii gave your account a different base URL.
TERMII_BASE_URL=https://api.ng.termii.com

# Email (email verification codes) — same console fallback as above.
# "console" logs the code; "resend" sends real email via resend.com.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Optional. The "From" address, e.g. "Gracerandly <noreply@yourdomain.com>".
# Without a verified domain, Resend only delivers to your own account email.
EMAIL_FROM=

# Set to "true" to echo verification codes back in the API response, for
# local testing without a real SMS/email provider wired up. Must be unset
# (or "false") in any environment a real user can reach — it defeats the
# purpose of the OTP otherwise.
EXPOSE_DEV_VERIFICATION_CODES=false

# Get a key from https://console.anthropic.com/settings/keys. Powers the
# "parse with AI" entry point on the create-errand form (POST
# /errands/parse, lib/ai.ts) — turns a pasted free-text list into a draft
# category/items/instructions the requester reviews before posting. Same
# fail-loudly stance as Paystack above: no console fallback, an unset key
# makes that one endpoint return an error rather than fake a parse. Manual
# entry (the rest of the create-errand form) works regardless.
ANTHROPIC_API_KEY=

# Get an App ID + App Certificate from https://console.agora.io (free tier:
# 10,000 minutes/month). Powers audio/video calling (lib/agora.ts) — minting
# a short-lived join token per call. With these unset, the call-token
# endpoints fail loudly (same stance as Paystack/Anthropic above); chat
# text/voice-note messaging works fine without them, since calling is the
# only feature that touches Agora.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# SOS / panic button: comma-separated phone numbers texted on an SOS, e.g. +2348031234567,+2349011223344
# Needs a real SMS_PROVIDER to actually send; with console it only logs.
SOS_ALERT_PHONES=
# Same idea by email: comma-separated addresses emailed on an SOS (and again
# when the person marks themselves safe), e.g. safety@example.com,ops@example.com
# Needs EMAIL_PROVIDER=resend to actually send; with console it only logs.
# Resend's shared test sender (no EMAIL_FROM) only delivers to the email on
# your own Resend account — put that address here to test, and verify a
# domain in Resend before listing anyone else.
# You can set either list or both; the apps tell the user the safety team was
# alerted if at least one text or email really went out.
SOS_ALERT_EMAILS=

# Push notifications (new chat messages / missed calls while the app is
# closed) go through Expo's push service and need no key on this server.
# Optional: if you turn on "Enhanced Push Security" for the project in the
# Expo dashboard, put the access token here.
EXPO_ACCESS_TOKEN=
