# Optional. Overrides the API base URL the app talks to (see src/lib/apiClient.ts).
# Leave unset for normal dev — it's auto-detected: your machine's LAN IP when
# running via `expo start` (Expo Go or a dev client), 10.0.2.2 on the Android
# emulator, localhost on iOS simulator/web.
EXPO_PUBLIC_API_URL=

# Required for publishing live position while on an errand (src/lib/realtime.ts).
# Project URL and anon (public) key from Supabase → Settings → API. Same
# project as apps/requester's — the anon key is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
